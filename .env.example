# Telegram bot token from @BotFather
BOT_TOKEN=replace_with_bot_token

# Supabase PostgreSQL direct or session-mode connection URL (not transaction pooler)
DATABASE_URL=postgresql://postgres:password@host:5432/postgres?sslmode=require

# Optional AI moderation (set the key to enable Groq analysis)
# Messages matching suspicious-content signals are sent to Groq for classification.
GROQ_API_KEY=replace_with_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
